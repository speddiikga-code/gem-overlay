#!/bin/sh
# Strip AI co-author and "generated with" lines from every commit message,
# whichever tool wrote them, then run the repository's own commit-msg hook.
# Co-authors are matched by the tools' addresses, or by a bare tool name with no address, so a
# human named Cursor Kim or Jean-Claude Roy stays. "Generated with" must open the line (after any
# emoji) so an ordinary sentence such as "rows generated by the DB cursor" is kept; LC_ALL=C lets
# [^[:alnum:]] step over the emoji's bytes.
LC_ALL=C sed -i -E \
  -e '/^[[:space:]]*co-authored-by:.*<[^>]*(@anthropic\.com|@openai\.com|@cursor\.(com|sh)|copilot@users\.noreply\.github\.com|devin-ai-integration|gemini-code-assist|google-labs-jules|@aider\.chat|@opencode\.ai|@codeium\.com|@windsurf\.com|@tabnine\.com)/Id' \
  -e '/^[[:space:]]*co-authored-by:[[:space:]]*(claude|copilot|cursor|codex|chatgpt|gemini|devin|aider|codeium|windsurf|tabnine|jules|opencode)[^<]*$/Id' \
  -e '/^[[:space:]]*claude-session:/Id' \
  -e '/^[^[:alnum:]]*generated (with|by) \[?(claude|copilot|cursor|codex|chatgpt|gemini|aider|opencode)/Id' \
  "$1"
# --git-common-dir, not --git-dir: in a linked worktree the hooks live in the main repository.
local_hook="$(git rev-parse --git-common-dir)/hooks/commit-msg"
[ -x "$local_hook" ] && exec "$local_hook" "$@"
exit 0
